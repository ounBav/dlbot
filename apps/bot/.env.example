# Telegram
BOT_TOKEN=123456:replace-me
ADMIN_IDS=123456789
TERMS_URL=https://example.com/terms

# Long polling: seconds each getUpdates call waits for new updates (no webhook, no public URL).
# Only one process may poll per token: use a separate dev bot locally.
POLL_TIMEOUT=25
# Ping our own RENDER_EXTERNAL_URL/health every KEEPALIVE_INTERVAL_SEC (Render sets that URL).
# Only keeps an already-awake service awake; an external pinger is still needed (README).
KEEPALIVE_SELF_PING=false
KEEPALIVE_INTERVAL_SEC=600

# Limits
MAX_UPLOAD_MB=50
RATE_PER_MINUTE=5
RATE_PER_DAY=30
WORKER_CONCURRENCY=2
MAX_JOB_ATTEMPTS=3
# Per-job download folders (deleted after each send). Relative = inside the project.
TEMP_DIR=tmp

# Telegram Mini App (apps/miniapp). Empty MINIAPP_URL = Mini App disabled (no menu button).
# Must be HTTPS for Telegram (e.g. an ngrok tunnel to :5173 locally).
MINIAPP_URL=
MINIAPP_AUTH_MAX_AGE=86400
# Extra CORS origins for the Mini App API (MINIAPP_URL's origin is always allowed).
CORS_ORIGINS=http://localhost:5173
# Mini App "Save to device": finished files stay behind an unguessable link this long, then are deleted.
FILE_TTL_MIN=15
# Mini App link previews (POST /api/info) per user per minute. Downloads use RATE_PER_MINUTE/DAY.
INFO_RATE_PER_MINUTE=20
# Longest accepted video in seconds; 0 = no limit (open question Q4).
MAX_DURATION_SEC=0
