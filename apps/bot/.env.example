# Telegram
BOT_TOKEN=123456:replace-me
WEBHOOK_SECRET=replace-with-random-string-32-chars
PUBLIC_BASE_URL=https://marleen-aquiver-graeme.ngrok-free.dev
ADMIN_IDS=123456789
TERMS_URL=https://example.com/terms
TELEGRAM_WEBHOOK_URL = https://marleen-aquiver-graeme.ngrok-free.dev/telegram/webhook

# Infrastructure
DB_HOST="localhost"
DB_PORT=5432
# DB_SCHEMA is the PostgreSQL database name.
DB_SCHEMA="bot"
DB_USERNAME="bot"
DB_PASSWORD="bot"
DB_CONNECTION="postgres"
DB_LOGGING=true
DB_SYNC=true
REDIS_URL=redis://localhost:6379/0

# Limits
MAX_UPLOAD_MB=50
RATE_PER_MINUTE=5
RATE_PER_DAY=30
WORKER_CONCURRENCY=2
MAX_JOB_ATTEMPTS=3
TEMP_DIR=/tmp/dlbot

# Telegram Mini App (apps/miniapp). Empty MINIAPP_URL = Mini App disabled (no menu button).
# Must be HTTPS for Telegram (e.g. an ngrok tunnel to :5173 locally).
MINIAPP_URL=
MINIAPP_AUTH_MAX_AGE=86400
# Extra CORS origins for the Mini App API (MINIAPP_URL's origin is always allowed).
CORS_ORIGINS=http://localhost:5173
